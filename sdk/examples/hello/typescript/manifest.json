{
  "id": "org.ether.examples.hello",
  "version": "0.1.0",
  "name": "Hello plugin",
  "description": "Minimal greeting plugin for Ether.",
  "types": ["movie"],
  "idPrefixes": ["tt"],
  "catalogs": [
    {
      "type": "movie",
      "id": "hello",
      "name": "Hello movies",
      "extra": [{ "name": "search", "isRequired": false }]
    }
  ],
  "resources": ["catalog", "meta", "subtitles"],
  "ether": {
    "protocol": 1,
    "kind": "extension",
    "capabilities": ["list_source", "subtitles", "ui", "ranking_step", "rule_condition"],
    "summary": "Minimal greeting plugin for Ether.",
    "runtime": {
      "kind": "hosted",
      "entry": "plugin.ts"
    },
    "permissions": {
      "catalog": "none"
    },
    "settings": {
      "fields": [
        {
          "key": "greeting",
          "kind": "text",
          "label": "Greeting word",
          "hint": "Word used to greet viewers in the catalog and view",
          "default": "Hello"
        }
      ]
    },
    "contributes": {
      "listSources": [
        {
          "key": "hello",
          "label": "Hello movies",
          "hint": "Sample movie list from the hello plugin",
          "catalog": "hello",
          "refresh": "1h"
        }
      ],
      "subtitles": {
        "languages": ["en"],
        "formats": ["vtt"]
      },
      "pages": [
        {
          "key": "home",
          "label": "Hello overview",
          "route": "/ether/view/home"
        }
      ],
      "rankingSteps": [
        {
          "key": "cached_boost",
          "label": "Boost cached releases",
          "hint": "Adds a score bonus when a release is cached"
        }
      ],
      "ruleConditions": [
        {
          "key": "is_cached",
          "label": "Release is cached",
          "operators": ["eq"]
        }
      ]
    }
  }
}
